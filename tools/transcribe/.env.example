# Template. Committed to git on purpose — so NEVER put a real key in this file.
#
# The .gitignore pattern ".env" matches only that exact filename, not
# ".env.example". A real key here goes straight into your next commit.
#
#   cp .env.example .env     <- .env IS gitignored; the real key goes there
#
# Get a key at https://platform.claude.com/
ANTHROPIC_API_KEY=sk-ant-...
